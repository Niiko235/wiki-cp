---
import LayoutContent from '../../layouts/LayoutContent.astro'
import { getCollection, render } from 'astro:content'
import katex from 'katex'
import Badge from '../../components/Badge.astro'
import { Icon } from 'astro-icon/components'

export async function getStaticPaths() {
  const teorias = await getCollection('teorias')
  return teorias.map((teoria) => ({
    params: { id: teoria.id },
    props:  { teoria }
  }))
}

const { teoria } = Astro.props
const { data }   = teoria
const {
  titulo,
  autores,
  complejidad,
  fechaEscrito,
  fechaUltimaActualizacion,
  problemas,
} = data

const { Content }    = await render(teoria)
const complejidadHTML = katex.renderToString(complejidad, { throwOnError: false })
const categoria       = teoria.id.split('-')[0]
---

<LayoutContent titulo={titulo}>
  <main class="flex-1 h-full overflow-y-auto px-6 py-10">
      <div class="max-w-4xl mx-auto ">

      <p class="text-[11px] font-mono text-subtle mb-4">
        Documentación
        <span class="mx-1 text-border-dark">›</span>
        <span class="capitalize">{categoria}</span>
        <span class="mx-1 text-border-dark">›</span>
        <span class="text-muted">{titulo}</span>
      </p>


      <h1 class="text-3xl font-extrabold text-title tracking-tight leading-tight mb-4">
        {titulo}
      </h1>


      <div class="flex flex-wrap gap-2 mb-6">
        <span class="text-[11px] font-semibold px-3 py-1 rounded-full border
                    text-grafos-text bg-grafos-bg border-grafos-border font-mono">
          <span set:html={complejidadHTML} />
        </span>
      </div>


      <div class="flex flex-wrap gap-4 text-[12px] text-subtle font-mono mb-6
                  pb-6 border-b border-border">
        <span>✍️ {autores.join(', ')}</span>
        <span>📅 {fechaEscrito.toLocaleDateString('es-CO', { dateStyle: 'medium' })}</span>
        <span>🔄 {fechaUltimaActualizacion.toLocaleDateString('es-CO', { dateStyle: 'medium' })}</span>
      </div>


      <div class="prose prose-neutral dark:prose-invert max-w-none prose-code:before:content-none prose-code:after:content-none pb-6">
        <Content/>
      </div>

      {
        categoria !== 'introduccion' && (
          <div >
            <h3>Ejercicios</h3>
            <div class="grid grid-col-1 md:grid-cols-2 xl:grid-cols-3 gap-4" >
              {problemas.map(problema => {
                const lvl = problema.nivelProblema.toLowerCase()
                if(lvl !== 'bronce') return
                return (
                   <a href={problema.urlProblema} target="_blank" rel="noopener noreferrer">
                      <div class="flex items-center justify-between border rounded-xl px-3 py-1.5 border-border">
                        <div class="min-w-0 flex-1">
                          <p class="truncate">{problema.nombreProblema}</p>
                          <span>{problema.nombrePlataforma}</span>
                        </div>
                        <div class="flex items-center gap-2">
                          <Badge class={`flex items-center gap-1 border bg-${lvl}-bg border-${lvl}-border text-${lvl}-text`}>
                            <span class={`size-3 rounded-full bg-${lvl}-border`}></span>
                            <span class="font-semibold">{lvl}</span>
                          </Badge>
                          <Icon name="lucide:square-arrow-out-up-right" size={18}/>
                        </div>

                    </div>
                  </a>
                )
              }
               
              )}
              {problemas.map(problema => {
                const lvl = problema.nivelProblema.toLowerCase()
                if(lvl !== 'plata') return
                return (
                   <a href={problema.urlProblema} target="_blank" rel="noopener noreferrer">
                      <div class="flex items-center justify-between border rounded-xl px-3 py-1.5 border-border">
                        <div class="min-w-0 flex-1">
                          <p class="truncate">{problema.nombreProblema}</p>
                          <span>{problema.nombrePlataforma}</span>
                        </div>
                        <div class="flex items-center gap-2">
                          <Badge class={`flex items-center gap-1 border bg-${lvl}-bg border-${lvl}-border text-${lvl}-text`}>
                            <span class={`size-3 rounded-full bg-${lvl}-border`}></span>
                            <span class="font-semibold">{lvl}</span>
                          </Badge>
                          <Icon name="lucide:square-arrow-out-up-right" size={18}/>
                        </div>

                    </div>
                  </a>
                )
              }
               
              )}
              {problemas.map(problema => {
                const lvl = problema.nivelProblema.toLowerCase()
                if(lvl !== 'oro') return
                return (
                   <a href={problema.urlProblema} target="_blank" rel="noopener noreferrer">
                      <div class="flex items-center justify-between border rounded-xl px-3 py-1.5 border-border">
                        <div class="min-w-0 flex-1">
                          <p class="truncate">{problema.nombreProblema}</p>
                          <span>{problema.nombrePlataforma}</span>
                        </div>
                        <div class="flex items-center gap-2">
                          <Badge class={`flex items-center gap-1 border bg-${lvl}-bg border-${lvl}-border text-${lvl}-text`}>
                            <span class={`size-3 rounded-full bg-${lvl}-border`}></span>
                            <span class="font-semibold">{lvl}</span>
                          </Badge>
                          <Icon name="lucide:square-arrow-out-up-right" size={18}/>
                        </div>

                    </div>
                  </a>
                )
              }
               
              )}
            </div>
          </div>

        )
      }

    </div>
  </main>
</LayoutContent>