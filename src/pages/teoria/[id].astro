---
import Navbar from '../../components/Navbar.astro';
import Layout from '../../layouts/Layout.astro'
import { getCollection, render } from "astro:content";


export async function getStaticPaths() {
    const teorias = await getCollection("teorias");

    console.log(teorias.map(t => t.id));

    return teorias.map((teoria) => ({
        params: {id : teoria.id},
        props: {teoria}
    }))
}


const {teoria} = Astro.props
const {data} = teoria
const {author, title} = data

const {Content} = await render(teoria)
---


<Layout>
    <Navbar/>
    <div class="flex">
        <div class="h-full w-md bg-cyan-500">

        </div>
        <section class="prose dark:prose-invert">
            <Content/>
        </section>
    </div>
</Layout>