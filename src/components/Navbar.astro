---
import { Icon } from 'astro-icon/components'
import Button from '../components/Button.astro'
import Logo from '../components/Logo.astro'
import NavLinks from '../components/NavLinks.astro'
import Buscador from '../components/Buscador.astro'
import { REDES } from '../lib/enlaces'
---

<header class="sticky top-0 z-50 h-(--navbar-h) border-b border-border bg-base text-body">
    <!-- El fondo y el borde ocupan todo el ancho; el contenido se limita al ancho del sitio. -->
    <div class="mx-auto flex h-full max-w-shell items-center justify-between gap-2 px-4">
        <div class="flex items-center gap-3">
            <Button
                variante="icono"
                id="menu-toggle-btn"
                aria-label="Abrir menú"
                aria-controls="mobile-drawer"
                aria-expanded="false"
                class="md:hidden"
            >
                <Icon name="lucide:menu" class="size-5" />
            </Button>

            <Logo href={import.meta.env.BASE_URL} />
        </div>

        <nav aria-label="Principal" class="hidden md:block">
            <NavLinks />
        </nav>

        <div class="flex items-center gap-2 text-muted">
            <Buscador />
            <Button variante="icono" id="btn-tema" aria-label="Cambiar entre tema claro y oscuro">
                <Icon name="lucide:moon" class="dark:hidden" />
                <Icon name="lucide:sun" class="hidden dark:inline" />
            </Button>
            <!-- En móvil las redes viven dentro del menú lateral -->
            <div class="hidden items-center gap-2 md:flex">
                <Button variante="icono" href={REDES.facebook} aria-label="Facebook">
                    <Icon name="simple-icons:facebook" />
                </Button>
                <Button variante="icono" href={REDES.instagram} aria-label="Instagram">
                    <Icon name="simple-icons:instagram" />
                </Button>
            </div>
        </div>
    </div>
</header>

<script>
    // Menú lateral móvil: botón, overlay, botón de cerrar y tecla Escape.
    const btn = document.getElementById('menu-toggle-btn');
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('drawer-overlay');
    const cerrar = document.getElementById('drawer-close');

    function setAbierto(abierto: boolean) {
        drawer?.classList.toggle('-translate-x-full', !abierto);
        overlay?.classList.toggle('hidden', !abierto);
        document.body.classList.toggle('overflow-hidden', abierto);
        btn?.setAttribute('aria-expanded', String(abierto));
    }

    btn?.addEventListener('click', () => setAbierto(btn?.getAttribute('aria-expanded') !== 'true'));
    overlay?.addEventListener('click', () => setAbierto(false));
    cerrar?.addEventListener('click', () => setAbierto(false));
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setAbierto(false);
    });
    // Si se ensancha la ventana con el menú abierto, se cierra para no dejar el scroll bloqueado.
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
        if (e.matches) setAbierto(false);
    });
</script>

<script>
    // El tema inicial lo aplica el script inline de BaseHead; aquí solo se alterna y se guarda.
    const btnTema = document.getElementById('btn-tema');
    btnTema?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch {}
    });
</script>
