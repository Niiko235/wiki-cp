---
import { Icon } from 'astro-icon/components'
import Buttom from '../components/Buttom.astro'

interface Props {
    showMenuButton?: boolean;
}

const { showMenuButton = true } = Astro.props;
---

<nav class={`${!showMenuButton ? 'flex-col md:flex-row' : ''} py-4 px-4 flex items-center justify-between border-b border-border text-body sticky top-0 bg-base z-50`}> 
    <div class="flex items-center gap-3">
        {showMenuButton && (
            <Buttom id="sidebar-toggle-btn" class="p-1.5 md:hidden text-primary bg-sidebar border border-border rounded-md hover:cursor-pointer transition-colors" aria-label="Abrir menú lateral">
                <Icon name="lucide:menu" class="w-5 h-5"/>
            </Buttom>
        )}

        <a href={import.meta.env.BASE_URL}>
            <div class="flex gap-1.5 font-semibold items-center">
                <p class="font-extrabold text-title text-xl">
                    wiki 
                    <span class="text-accent">cp</span>
                </p>
                <span>·</span>
                <p>udla</p>
            </div>
        </a>
    </div>

    <ul class={`${!showMenuButton ? 'flex' : 'hidden md:flex gap-2'}`}>
        <a href="/teoria/estructuras-segment-tree">
            <Buttom class="rounded-md px-3 py-1 hover:bg-sidebar hover:text-primary hover:font-bold">Teoria</Buttom>
        </a>
        <a href="/ejercicios">
            <Buttom class="rounded-md px-3 py-1 hover:bg-sidebar hover:text-primary hover:font-bold">Ejercicios</Buttom>
        </a>
        <a href="/agradecimientos">
            <Buttom class="rounded-md px-3 py-1 hover:bg-sidebar hover:text-primary hover:font-bold">Agradecimientos</Buttom>
        </a>
    </ul>

    <ul class={`${!showMenuButton ? 'hidden md:flex' : 'flex'} gap-2 text-muted items-center`}>
        <Buttom id="btn-tema" class="bg-sidebar p-1.5 border border-border rounded-md cursor-pointer">
            <Icon name="lucide:moon"/>
        </Buttom>
        <a href="https://www.facebook.com/groups/792879287501813" target="_blank" aria-label="Facebook">
            <Buttom class="bg-sidebar p-1.5 border border-border rounded-md"><Icon name="simple-icons:facebook"/></Buttom>
        </a>
        <a href="https://www.instagram.com/udla_cp" target="_blank" aria-label="Instagram">
            <Buttom class="bg-sidebar p-1.5 border border-border rounded-md"><Icon name="simple-icons:instagram"/></Buttom>
        </a>
    </ul>
</nav>

<script>
    const btn = document.getElementById('btn-tema');
    btn?.addEventListener('click', () => {
        document.documentElement.classList.toggle('dark');
        const isDark = document.documentElement.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
</script>