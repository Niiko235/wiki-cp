---
import { REDES } from '../lib/enlaces'
import Logo from './Logo.astro'
---

<footer>
    <div class="mx-auto flex max-w-shell flex-col justify-between px-5 py-4 text-body sm:flex-row sm:px-10">
        <div class="text-center sm:text-left">
            <Logo class="mb-2" />
            <p class="text-xs">Semillero de programación · Florencia, Caquetá</p>
        </div>
        <ul class="flex justify-evenly items-center gap-4 mt-4 sm:mt-0">
            <li><a class="underline" href={REDES.github}>Github</a></li>
            <li><a class="underline" href={REDES.facebook}>Facebook</a></li>
        </ul>
    </div>
</footer>
