---
import { Icon } from 'astro-icon/components'
import { creadores } from '../lib/info-autores'
import Button from './Button.astro'
---

<section class="mb-10 border-b border-border pb-10" aria-labelledby="titulo-autores">
    <h2 id="titulo-autores" class="mb-5 text-xs font-semibold tracking-[0.25rem] text-muted">AUTORES OFICIALES</h2>

    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {creadores.map(creador => (
            <li class="flex flex-col gap-4 rounded-xl border border-border bg-card p-5 transition-colors hover:border-border-dark">
                <div class="flex items-center gap-3">
                    <img
                        src={creador.avatar ?? `https://github.com/${creador.perfilGit}.png?size=112`}
                        alt=""
                        width="56"
                        height="56"
                        loading="lazy"
                        decoding="async"
                        class="size-14 shrink-0 rounded-full border border-border bg-sidebar object-cover"
                    />
                    <div class="min-w-0">
                        <h3 class="font-bold leading-tight text-title">{creador.nombre}</h3>
                        <p class="mt-0.5 text-sm text-muted">{creador.carrera} · {creador.semestre}</p>
                    </div>
                </div>

                <p class="text-sm leading-relaxed text-body">{creador.descripcion}</p>

                <Button
                    href={`https://github.com/${creador.perfilGit}`}
                    variante="secundario"
                    aria-label={`Perfil de GitHub de ${creador.nombre}`}
                    class="mt-auto w-fit px-3! py-1.5! text-sm"
                >
                    <Icon name="simple-icons:github" class="size-4" />
                    @{creador.perfilGit}
                </Button>
            </li>
        ))}
    </ul>
</section>
