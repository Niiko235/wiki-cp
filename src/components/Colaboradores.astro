---
import { colaboradores } from '../lib/info-autores'
import Button from './Button.astro'
---

<section aria-labelledby="titulo-colaboradores">
    <h2 id="titulo-colaboradores" class="mb-4 text-xs font-semibold tracking-[0.25rem] text-muted">COLABORADORES</h2>

    <ul class="mb-8 flex flex-wrap gap-2">
        {colaboradores.map(colaborador => (
            <li class="rounded-full border border-border bg-sidebar px-3 py-1 text-sm font-medium text-primary">
                {colaborador}
            </li>
        ))}
    </ul>

    <div class="flex flex-col items-start gap-3 rounded-xl border border-dashed border-border-dark p-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="font-semibold text-title">¿Quieres aparecer aquí?</p>
            <p class="text-sm text-body">Escribe o mejora un tema de la wiki y tu nombre quedará en esta lista.</p>
        </div>
        <Button href="/teoria/introduccion/bienvenida#cómo-contribuir" variante="primario" class="shrink-0 whitespace-nowrap">
            Cómo contribuir →
        </Button>
    </div>
</section>
