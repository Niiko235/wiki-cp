---
/**
 * Logo de texto «wiki cp · udla». Con `href` se vuelve enlace (el navbar lo usa para volver al inicio).
 * Es un <span>, no un <p>, para poder ir dentro de un enlace o de un párrafo sin romper el HTML.
 */
interface Props {
    href?: string
    class?: string
}

const { href, class: className } = Astro.props
const Etiqueta = href ? 'a' : 'span'
---

<Etiqueta
    href={href}
    aria-label={href ? 'Wiki CP UDLA, ir al inicio' : undefined}
    class:list={['inline-flex items-center gap-1.5 font-semibold text-body', className]}
>
    <span class="text-xl font-extrabold text-title">wiki <span class="text-accent">cp</span></span>
    <span aria-hidden="true">·</span>
    <span>udla</span>
</Etiqueta>
