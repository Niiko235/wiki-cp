---
import Navbar from '../components/Navbar.astro';
import Sidebar from '../components/Sidebar.astro';
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css'

interface Props {
    titulo?: string;
    descripcion?: string;
}

const { titulo, descripcion } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead titulo={titulo} descripcion={descripcion} />
    </head>
    <body class="bg-base min-h-dvh flex flex-col">
        <Navbar />
        <!-- Aquí el sidebar solo existe como menú móvil (navegación general y redes) -->
        <Sidebar conTemario={false} />

        <main class="flex-1">
            <slot />
        </main>
    </body>
</html>
