---
import Navbar from '../components/Navbar.astro';
import Sidebar from '../components/Sidebar.astro';
import BaseHead from '../components/BaseHead.astro';
import ImageZoom from '../components/ImageZoom.astro';
import '../styles/global.css'

interface Props {
    titulo?: string;
    descripcion?: string;
}

const { titulo, descripcion } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead titulo={titulo} descripcion={descripcion} />
    </head>
    <body class="bg-base min-h-dvh flex flex-col">
        <Navbar />
        <!-- Shell del sitio: navbar, sidebar y contenido comparten el mismo ancho máximo (1400px) -->
        <div class="mx-auto flex w-full max-w-shell flex-1">
            <Sidebar />
            <main class="min-w-0 flex-1">
                <slot />
            </main>
        </div>
        <ImageZoom />
    </body>
</html>
